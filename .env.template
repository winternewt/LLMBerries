# LLMBerries — copy to .env and fill in. .env is git-ignored.
#
# Every provider below is used with a free-tier key. Pacing quotas live in
# entities/llm_configs.py; verify a key with:
#   uv run python scripts/key_test.py

# Google AI Studio (gemini-3.7-flash) — free tier, 10 RPM
GOOGLE_API_KEY=

# Groq (openai/gpt-oss-120b) — free tier, 30 RPM / 8k TPM / 200k tokens per DAY per key.
# Several keys are allowed per provider: comma-separate them here, or add numbered
# variants (GROQ_API_KEY_2, GROQ_API_KEY_3...). The drum rotates to the next key when
# one comes back spent, so a long game outlives any single daily quota.
GROQ_API_KEY=
GROQ_API_KEY_2=

# DeepSeek (deepseek-v4-flash) — pay-as-you-go, needs a funded balance
DEEPSEEK_API_KEY=

# Cerebras (gpt-oss-120b) — free tier subject to daily token quota
CEREBRAS_API_KEY=
